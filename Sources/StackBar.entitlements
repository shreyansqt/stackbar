<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- We must spawn arbitrary dev commands and open user-chosen folders,
         so the app sandbox is OFF for V1. Revisit before distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
